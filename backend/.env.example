# Backend configuration. Copy to backend/.env and edit as needed.

# live fetches Elexon; snapshot uses locally generated offline data.
DATA_SOURCE=live
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
LIVE_CACHE_TTL_SECONDS=300
# Comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173

APP_ENV=development
LOG_LEVEL=INFO
# DATA_DIR=./data

ELEXON_TIMEOUT_SECONDS=30
ELEXON_MAX_RETRIES=3
ELEXON_RETRY_BASE_SECONDS=1
ELEXON_WINDOW_DAYS=7

# Pilot cutoff assumption, not an official Elexon rule.
DECISION_CUTOFF_LOCAL_TIME=09:20
DECISION_CUTOFF_DAY_OFFSET=-1
DECISION_CUTOFF_TIMEZONE=Europe/London

# hourly_block applies each hourly value to both half-hours; exact matches one.
FORECAST_MAPPING=hourly_block
